{
  "name": "@dhinesh-se/angular-components",
  "version": "0.4.0",
  "description": "Reusable enterprise Angular building blocks: permission directive, workflow timeline, smart table, dynamic forms, and query builder.",
  "license": "MIT",
  "author": "Dhinesh SE",
  "homepage": "https://github.com/Dhinesh-Se/Angular_components#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhinesh-Se/Angular_components"
  },
  "bugs": {
    "url": "https://github.com/Dhinesh-Se/Angular_components/issues"
  },
  "keywords": [
    "angular",
    "components",
    "enterprise",
    "permissions",
    "workflow",
    "table",
    "forms",
    "query-builder"
  ],
  "private": false,
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist out-tsc",
    "build": "ng build enterprise-components && node -e \"const pkg = require('./dist/enterprise-components/package.json'); delete pkg.scripts; require('fs').writeFileSync('./dist/enterprise-components/package.json', JSON.stringify(pkg, null, 2))\"",
    "test": "ng test enterprise-components --watch=false",
    "lint": "ng lint enterprise-components",
    "pack:dry-run": "npm pack ./dist/enterprise-components --dry-run",
    "publish:dry-run": "npm publish ./dist/enterprise-components --dry-run --access public",
    "publish:public": "npm run version:auto && npm publish ./dist/enterprise-components --access public",
    "version:auto": "node scripts/auto-bump-version.mjs",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@angular/forms": ">=17.0.0",
    "rxjs": ">=7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular/cli": "^21.2.10",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.15",
    "@angular/platform-browser-dynamic": "^21.2.15",
    "@eslint/js": "^9.21.0",
    "@types/jasmine": "^5.1.15",
    "eslint": "^9.21.0",
    "husky": "^9.0.0",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^21.2.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "zone.js": "^0.16.0"
  }
}
